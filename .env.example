GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Achernar
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_PROMPT_CACHE_TTL_SECONDS=3600
GEMINI_WHATSAPP_MODEL=gemini-3.5-flash

# Meta WhatsApp Cloud API — use the values shown in your Meta test-number setup.
WHATSAPP_ACCESS_TOKEN=your-temporary-or-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_VERIFY_TOKEN=create-a-long-random-webhook-token
META_APP_SECRET=your-meta-app-secret

# Digits only. The webhook ignores every other sender while this is a demo.
WHATSAPP_TEST_RECIPIENT=201XXXXXXXXX
